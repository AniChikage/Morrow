{
  "name": "morrow",
  "productName": "Morrow",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "A local-first Mac app that lets Codex take continuing responsibility for project goals.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node service/server.ts",
    "test": "node --test tests/*.test.ts",
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "build:app": "bash scripts/build-electron.sh",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
